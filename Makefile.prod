# Memphis Admin - Production Makefile
# ============================================================================
# Usage: make -f Makefile.prod <target>
# Run 'make help' to see all available commands
# ============================================================================

# Variables
COMPOSE = docker compose -f compose.prod.yaml
EXEC = $(COMPOSE) exec php-fpm
ARTISAN = $(EXEC) php artisan

# Colors
YELLOW := \033[1;33m
GREEN := \033[1;32m
CYAN := \033[1;36m
RED := \033[1;31m
RESET := \033[0m

.DEFAULT_GOAL := help

.PHONY: help
help: ## Show this help
	@echo ""
	@echo "$(CYAN)Memphis Admin - Production Commands$(RESET)"
	@echo ""
	@awk 'BEGIN {FS = ":.*##"} /^[a-zA-Z_-]+:.*##/ { printf "  $(GREEN)%-20s$(RESET) %s\n", $$1, $$2 }' $(MAKEFILE_LIST)
	@echo ""

# ============================================================================
# Docker
# ============================================================================

.PHONY: up down restart build logs ps health

up: ## Start production containers
	$(COMPOSE) up -d

down: ## Stop production containers
	$(COMPOSE) down

restart: down up ## Restart containers

build: ## Build production images
	$(COMPOSE) build --no-cache

build-up: ## Build and start
	$(COMPOSE) up -d --build

logs: ## View logs
	$(COMPOSE) logs -f

logs-%: ## View specific service logs (e.g., make logs-php-fpm)
	$(COMPOSE) logs -f $*

ps: ## List containers
	$(COMPOSE) ps

health: ## Check services health
	@echo "$(CYAN)Checking services health...$(RESET)"
	@$(COMPOSE) ps --format "table {{.Name}}\t{{.Status}}"
	@echo ""
	@$(ARTISAN) about --only=Environment 2>/dev/null || echo "$(RED)PHP-FPM not responding$(RESET)"

# ============================================================================
# Deployment
# ============================================================================

.PHONY: deploy deploy-quick rollback-deploy

deploy: confirm ## Full deployment (build + migrate + optimize)
	@echo "$(YELLOW)Starting deployment...$(RESET)"
	$(COMPOSE) build
	$(COMPOSE) up -d
	$(ARTISAN) migrate --force
	$(ARTISAN) optimize
	$(ARTISAN) filament:assets
	$(ARTISAN) queue:restart
	@echo "$(GREEN)Deployment complete!$(RESET)"

deploy-quick: ## Quick deploy (no build, just restart + migrate)
	@echo "$(YELLOW)Quick deployment...$(RESET)"
	$(COMPOSE) up -d
	$(ARTISAN) migrate --force
	$(ARTISAN) optimize
	$(ARTISAN) queue:restart
	@echo "$(GREEN)Quick deployment complete!$(RESET)"

deploy-assets: ## Deploy only frontend assets
	$(ARTISAN) filament:assets
	$(ARTISAN) view:cache

# ============================================================================
# Maintenance Mode
# ============================================================================

.PHONY: maintenance-on maintenance-off maintenance-status

maintenance-on: ## Enable maintenance mode
	$(ARTISAN) down --render="errors::503" --retry=60
	@echo "$(YELLOW)Maintenance mode enabled$(RESET)"

maintenance-off: ## Disable maintenance mode
	$(ARTISAN) up
	@echo "$(GREEN)Application is live$(RESET)"

maintenance-status: ## Check maintenance status
	@$(ARTISAN) env 2>/dev/null && echo "$(GREEN)Application is UP$(RESET)" || echo "$(YELLOW)Application is in MAINTENANCE$(RESET)"

# ============================================================================
# Optimization
# ============================================================================

.PHONY: optimize optimize-clear cache-warm

optimize: ## Full optimization for production
	$(ARTISAN) config:cache
	$(ARTISAN) route:cache
	$(ARTISAN) view:cache
	$(ARTISAN) event:cache
	$(ARTISAN) icons:cache
	@echo "$(GREEN)Application optimized$(RESET)"

optimize-clear: ## Clear all optimizations
	$(ARTISAN) optimize:clear

cache-warm: ## Warm up caches
	$(ARTISAN) config:cache
	$(ARTISAN) route:cache
	$(ARTISAN) view:cache
	$(ARTISAN) event:cache
	$(ARTISAN) icons:cache
	@echo "$(GREEN)Caches warmed$(RESET)"

# ============================================================================
# Database
# ============================================================================

.PHONY: migrate migrate-status migrate-force db-backup db-restore

migrate: ## Run migrations (with confirmation)
	$(ARTISAN) migrate --force

migrate-status: ## Show migration status
	$(ARTISAN) migrate:status

migrate-force: confirm ## Force run migrations
	$(ARTISAN) migrate --force

db-backup: ## Backup database
	@mkdir -p backups
	@echo "$(YELLOW)Creating backup...$(RESET)"
	$(COMPOSE) exec postgres pg_dump -U $${DB_USERNAME:-laravel} $${DB_DATABASE:-laravel} | gzip > backups/prod_backup_$$(date +%Y%m%d_%H%M%S).sql.gz
	@echo "$(GREEN)Backup saved to backups/$(RESET)"

db-restore: confirm ## Restore database (usage: make db-restore file=backups/backup.sql.gz)
	@echo "$(RED)WARNING: This will overwrite the production database!$(RESET)"
	@read -p "Type 'RESTORE' to confirm: " confirm && [ "$$confirm" = "RESTORE" ] || (echo "Aborted" && exit 1)
	gunzip -c $(file) | $(COMPOSE) exec -T postgres psql -U $${DB_USERNAME:-laravel} -d $${DB_DATABASE:-laravel}

# ============================================================================
# Queue & Scheduler
# ============================================================================

.PHONY: queue-status queue-restart queue-failed queue-retry queue-flush horizon-terminate

queue-status: ## Show queue status
	$(ARTISAN) queue:monitor redis:default

queue-restart: ## Restart queue workers
	$(ARTISAN) queue:restart
	@echo "$(GREEN)Queue workers will restart after current job$(RESET)"

queue-failed: ## List failed jobs
	$(ARTISAN) queue:failed

queue-retry: ## Retry all failed jobs
	$(ARTISAN) queue:retry all

queue-flush: confirm ## Flush all failed jobs
	$(ARTISAN) queue:flush

horizon-terminate: ## Gracefully terminate Horizon
	$(ARTISAN) horizon:terminate

# ============================================================================
# Logs & Monitoring
# ============================================================================

.PHONY: logs-laravel logs-error logs-tail

logs-laravel: ## View Laravel log
	$(EXEC) tail -f storage/logs/laravel.log

logs-error: ## View only errors
	$(EXEC) tail -f storage/logs/laravel.log | grep -i error

logs-tail: ## Tail last 100 lines
	$(EXEC) tail -100 storage/logs/laravel.log

# ============================================================================
# Filament
# ============================================================================

.PHONY: filament-assets filament-upgrade filament-cache

filament-assets: ## Publish Filament assets
	$(ARTISAN) filament:assets

filament-upgrade: ## Upgrade Filament after composer update
	$(ARTISAN) filament:upgrade

filament-cache: ## Cache Filament icons
	$(ARTISAN) icons:cache

# ============================================================================
# Security & Cleanup
# ============================================================================

.PHONY: security-check permissions-fix storage-link cleanup

security-check: ## Check for known vulnerabilities
	$(EXEC) composer audit

permissions-fix: ## Fix storage/cache permissions
	$(EXEC) chmod -R 775 storage bootstrap/cache
	$(EXEC) chown -R www-data:www-data storage bootstrap/cache

storage-link: ## Create storage symlink
	$(ARTISAN) storage:link

cleanup: ## Clean old logs and cache
	$(EXEC) find storage/logs -name "*.log" -mtime +30 -delete
	$(ARTISAN) cache:clear
	@echo "$(GREEN)Cleanup complete$(RESET)"

# ============================================================================
# Debugging (use with caution in production)
# ============================================================================

.PHONY: tinker routes config-show

tinker: ## Laravel Tinker (use with caution)
	@echo "$(RED)WARNING: You are entering Tinker in PRODUCTION$(RESET)"
	$(ARTISAN) tinker

routes: ## List routes
	$(ARTISAN) route:list --compact

config-show: ## Show current config
	$(ARTISAN) config:show

# ============================================================================
# Helpers
# ============================================================================

.PHONY: confirm shell

confirm:
	@echo "$(RED)You are about to run a command in PRODUCTION$(RESET)"
	@read -p "Are you sure? [y/N] " confirm && [ "$$confirm" = "y" ] || (echo "Aborted" && exit 1)

shell: ## Access PHP-FPM shell (emergency only)
	@echo "$(RED)WARNING: Entering production container shell$(RESET)"
	$(EXEC) bash

# ============================================================================
# Full Deployment Workflow
# ============================================================================

.PHONY: release

release: confirm ## Full release workflow
	@echo "$(CYAN)Starting release workflow...$(RESET)"
	@echo "$(YELLOW)1. Enabling maintenance mode...$(RESET)"
	$(ARTISAN) down --render="errors::503" --retry=60
	@echo "$(YELLOW)2. Creating backup...$(RESET)"
	@mkdir -p backups
	$(COMPOSE) exec postgres pg_dump -U $${DB_USERNAME:-laravel} $${DB_DATABASE:-laravel} | gzip > backups/pre_release_$$(date +%Y%m%d_%H%M%S).sql.gz
	@echo "$(YELLOW)3. Building containers...$(RESET)"
	$(COMPOSE) build
	@echo "$(YELLOW)4. Starting containers...$(RESET)"
	$(COMPOSE) up -d
	@echo "$(YELLOW)5. Running migrations...$(RESET)"
	$(ARTISAN) migrate --force
	@echo "$(YELLOW)6. Optimizing...$(RESET)"
	$(ARTISAN) optimize
	$(ARTISAN) filament:assets
	$(ARTISAN) icons:cache
	@echo "$(YELLOW)7. Restarting queues...$(RESET)"
	$(ARTISAN) queue:restart
	@echo "$(YELLOW)8. Disabling maintenance mode...$(RESET)"
	$(ARTISAN) up
	@echo "$(GREEN)Release complete!$(RESET)"
